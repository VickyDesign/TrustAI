# Copy to .env for local development. On Render, set these in the service's Environment tab.

# Supabase > Project settings > Database > Connection string > "Session pooler" (works over IPv4).
# Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Supabase > Project settings. The URL is used to verify sign-ins.
SUPABASE_URL=https://your-project-ref.supabase.co
# The same anon or publishable key the frontend uses (Settings > API Keys).
SUPABASE_ANON_KEY=
# Optional. With the legacy HS256 JWT secret set, sign-ins are verified locally instead of
# through Supabase Auth.
SUPABASE_JWT_SECRET=

# Encrypts agent credentials at rest. Any long random string works. Never change it after
# agents are saved, or their stored credentials can no longer be decrypted.
ENCRYPTION_KEY=

# Your Vercel URL(s), comma separated. Add a regex to allow preview deployments.
CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN_REGEX=

# Evaluation model: any OpenAI-compatible Chat Completions endpoint.
# Leave LLM_API_KEY empty to fall back to built-in rules.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Public URL of this API, shown as the gateway address. On Render it defaults to the service URL.
PUBLIC_API_URL=

# Allow agent URLs on private networks and localhost. Local development only.
ALLOW_PRIVATE_ENDPOINTS=false
